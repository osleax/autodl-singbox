def test_single_node(node):
    """手动测试单个节点，并保存最近一次测试结果。"""
    cache = load_speedtest_cache()
    tag = node["tag"]

    print(f"\n测试节点：{tag}")
    print("稳定性测试（5 次 GitHub HEAD）...")

    success, checks, latency = probe_node(
        node,
        checks=5,
        timeout=6,
    )
    rate = success / checks

    record = {
        "success_rate": rate,
        "latency": latency,
        "speed": None,
        "tested_at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    cache[tag] = record
    save_speedtest_cache(cache)

    if success == 0 or latency is None:
        print(f"✗ 稳定性测试：{success}/{checks}（{rate*100:.0f}%）")
        print("✗ 未达到下载测速条件")
        return

    print(
        f"✓ 稳定性：{success}/{checks} "
        f"（{rate*100:.0f}%） | "
        f"{latency*1000:.0f} ms"
    )

    if rate < 0.8:
        print("! 成功率低于 80%，跳过下载测速")
        return

    print(
        f"下载测速（约 {TEST_BYTES/1_000_000:.1f} MB）..."
    )

    speed = download_test_node(node)

    record["speed"] = speed if speed > 0 else None
    record["tested_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    save_speedtest_cache(cache)

    if speed > 0:
        print(
            f"✓ 下载速度：{speed/1024/1024:.2f} MB/s "
            f"({speed*8/1_000_000:.2f} Mbps)"
        )
    else:
        print("✗ 下载测速失败")


def test_node_group(group, full=False):
    """测试当前手动选择分组。

    full=False: 所有节点只做 5 次 HEAD。
    full=True:  所有节点先做 5 次 HEAD，成功率 >=80% 的节点全部下载测速。
    """
    cache = load_speedtest_cache()
    total = len(group)

    if full:
        print(
            f"\n组内完整测试：{total} 个节点"
            f"（5 次 HEAD；>=80% 的节点各下载约 "
            f"{TEST_BYTES/1_000_000:.1f} MB）\n"
        )
    else:
        print(
            f"\n组内低流量测试：{total} 个节点"
            "（每节点仅 5 次 GitHub HEAD）\n"
        )

    qualified = []

    print(
        f"并发 HEAD 测试：最多 {HEAD_WORKERS} 个节点同时测试..."
    )

    results = probe_nodes_parallel(
        group,
        checks=5,
        timeout=6,
    )

    for index, node, success, checks, latency in results:
        i = index + 1
        rate = success / checks

        cache[node["tag"]] = {
            "success_rate": rate,
            "latency": latency,
            "speed": None,
            "tested_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        save_speedtest_cache(cache)

        if success == 0 or latency is None:
            print(
                f"[{i:02d}/{total:02d}] "
                f"{success}/{checks} ({rate*100:3.0f}%)  "
                f"FAIL       {node['tag']}"
            )
            continue

        print(
            f"[{i:02d}/{total:02d}] "
            f"{success}/{checks} ({rate*100:3.0f}%)  "
            f"{latency*1000:6.0f} ms   "
            f"{node['tag']}"
        )

        # 稳定性不足的节点直接淘汰，不进入下载测速。
        if rate >= 0.8:
            qualified.append((rate, latency, node))
        elif full:
            print("         ↳ <80%，跳过下载测速")

    if not full:
        print("\n✓ 组内低流量测试完成")
        return

    if not qualified:
        print("\n! 当前组没有节点达到 80%，跳过下载测速")
        return

    print(
        f"\n开始下载测速：{len(qualified)} 个合格节点"
        f"（每节点约 {TEST_BYTES/1_000_000:.1f} MB）...\n"
    )

    for i, (rate, latency, node) in enumerate(qualified, 1):
        speed = download_test_node(node)

        record = cache[node["tag"]]
        record["speed"] = speed if speed > 0 else None
        record["tested_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
        save_speedtest_cache(cache)

        if speed > 0:
            print(
                f"[{i:02d}/{len(qualified):02d}] "
                f"{rate*100:3.0f}%  "
                f"{latency*1000:5.0f} ms  "
                f"{speed/1024/1024:6.2f} MB/s  "
                f"{node['tag']}"
            )
        else:
            print(
                f"[{i:02d}/{len(qualified):02d}] "
                f"FAIL  {node['tag']}"
            )

    print("\n✓ 组内完整测试完成")


def format_speedtest_record(node, cache):
    """格式化手动选择菜单中的最近测速数据。"""
    record = cache.get(node["tag"])
    if not isinstance(record, dict):
        return "未测试"

    rate = record.get("success_rate")
    latency = record.get("latency")
    speed = record.get("speed")
    tested_at = record.get("tested_at", "未知时间")

    if isinstance(rate, (int, float)):
        rate_text = f"{rate * 100:.0f}%"
    else:
        rate_text = "--"

    if isinstance(latency, (int, float)):
        latency_text = f"{latency * 1000:.0f} ms"
    else:
        latency_text = "FAIL"

    if isinstance(speed, (int, float)) and speed > 0:
        speed_text = f"{speed / 1024 / 1024:.2f} MB/s"
    else:
        speed_text = "未测速"

    return (
        f"{rate_text} | {latency_text} | "
        f"{speed_text} | {tested_at}"
    )


def choose_node():
    require_root()
    ensure_binary()
    if not CONFIG.exists():
        print("✗ 没有配置，请先运行 sb setup")
        return
    try:
        cfg = json.loads(CONFIG.read_text(encoding="utf-8"))
        selector = next((x for x in cfg.get("outbounds", [])
                         if x.get("type") == "selector" and x.get("tag") == "proxy"), None)
        if selector is None:
            print("✗ 配置中没有 proxy 选择器")
            return
        allowed = selector.get("outbounds", [])
        groups = [[] for _ in NODE_GROUP_TITLES]
        for node in cfg.get("outbounds", []):
            if node.get("type") in ("vless", "hysteria2") and node.get("tag") in allowed:
                groups[node_priority(node)].append(node)
        available = [(title, group) for title, group in zip(NODE_GROUP_TITLES, groups) if group]
        if not available:
            print("✗ 没有可选择的 VLESS/Hysteria2 节点")
            return
        while True:
            print(f"\n当前默认节点：{selector.get('default', '未设置')}")
            print("节点分组")
            for i, (title, group) in enumerate(available, 1):
                branch = "└─" if i == len(available) else "├─"
                print(f"{branch} [{i}] {title}（{len(group)} 个）")
            value = input("选择分组编号（0 退出）：").strip()
            if value == "0":
                return
            if not value.isdecimal() or not 1 <= int(value) <= len(available):
                print("请输入有效的分组编号")
                continue
            title, group = available[int(value) - 1]
            while True:
                cache = load_speedtest_cache()

                print(f"\n========== {title} ==========")
                print(f"当前默认节点：{selector.get('default', '未设置')}\n")

                for i, node in enumerate(group, 1):
                    mark = " ✓ 当前默认" if node["tag"] == selector.get("default") else ""
                    print(f"[{i}] {node['tag']}{mark}")
                    print(f"    {format_speedtest_record(node, cache)}")

                print("""
---------- 操作说明 ----------
1 / 2 / ...   直接切换节点
t 1           完整测试指定节点
l             组内低流量测试（全部节点仅 5×HEAD）
r             组内完整测试（全部节点 5×HEAD，>=80% 全部下载测速）
0             返回分组
q             退出
""")

                value = input("请输入操作：").strip().lower()

                if value == "0":
                    break

                if value == "q":
                    return

                if value == "l":
                    test_node_group(group, full=False)
                    continue

                if value == "r":
                    test_node_group(group, full=True)
                    continue

                match = re.fullmatch(r"t\s+(\d+)", value)
                if match:
                    index = int(match.group(1))
                    if not 1 <= index <= len(group):
                        print("请输入有效的节点编号")
                        continue

                    test_single_node(group[index - 1])
                    continue

                if not value.isdecimal() or not 1 <= int(value) <= len(group):
                    print("请输入有效操作")
                    continue

                selected = group[int(value) - 1]["tag"]
                selector['default'] = selected
                tmp = CONFIG_DIR / "config.json.new"
                save_config(cfg, tmp)
                if not check_config(tmp):
                    tmp.unlink(missing_ok=True)
                    print("✗ 新配置检查失败；原配置未修改")
                    return
                shutil.copy2(CONFIG, BACKUP)
                os.replace(tmp, CONFIG)
                print(f"✓ 已选择节点：{selected}")
                print(f"✓ 旧配置已备份：{BACKUP}")
                if find_pid():
                    restart()
                else:
                    start()
                return
    except (EOFError, KeyboardInterrupt):
        print("\n已取消选择")
    except Exception as e:
        print(f"✗ 手动选择失败：{e}")


def version():
    print(f"sb {SB_VERSION}")
    p = binary_path()
    if p.exists():
        run([str(p), "version"])
    else:
        print("sing-box: 未找到")

