def git_on():
    proxy = f"http://{HOST}:{PORT}"
    try:
        run(["git", "config", "--global", "http.proxy", proxy])
        run(["git", "config", "--global", "https.proxy", proxy])
        print(f"✓ Git 代理已开启：{proxy}")
    except FileNotFoundError:
        print("✗ 找不到 git")

def git_off():
    try:
        run(["git", "config", "--global", "--unset-all", "http.proxy"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        run(["git", "config", "--global", "--unset-all", "https.proxy"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("✓ Git 代理已关闭")
    except FileNotFoundError:
        print("✗ 找不到 git")

def parse_vless(uri, index):
    u = urllib.parse.urlsplit(uri.strip())
    if u.scheme.lower() != "vless":
        raise ValueError("不是 VLESS")
    uuid = urllib.parse.unquote(u.username or "")
    host, port = u.hostname, u.port
    if not uuid or not host or not port:
        raise ValueError("地址不完整")
    q = urllib.parse.parse_qs(u.query)

    def one(name, default=""):
        return urllib.parse.unquote(q.get(name, [default])[0])

    name = urllib.parse.unquote(u.fragment or f"节点-{index:02d}")
    tag = f"{index:02d}-{name}"
    ob = {"type": "vless", "tag": tag, "server": host, "server_port": port, "uuid": uuid}

    flow = one("flow")
    if flow:
        ob["flow"] = flow

    security = one("security").lower()
    if security in ("tls", "reality"):
        tls = {"enabled": True}
        sni = one("sni") or one("serverName")
        if sni: tls["server_name"] = sni
        fp = one("fp")
        if fp: tls["utls"] = {"enabled": True, "fingerprint": fp}
        if security == "reality":
            reality = {"enabled": True}
            pbk = one("pbk") or one("publicKey")
            sid = one("sid") or one("shortId")
            if pbk: reality["public_key"] = pbk
            if sid: reality["short_id"] = sid
            tls["reality"] = reality
        ob["tls"] = tls

    network = one("type").lower()
    if network == "ws":
        tr = {"type": "ws"}
        path, h = one("path"), one("host")
        if path: tr["path"] = path
        if h: tr["headers"] = {"Host": h}
        ob["transport"] = tr
    elif network == "grpc":
        tr = {"type": "grpc"}
        service = one("serviceName") or one("service_name")
        if service: tr["service_name"] = service
        ob["transport"] = tr
    elif network in ("http", "h2"):
        tr = {"type": "http"}
        h, path = one("host"), one("path")
        if h: tr["host"] = [h]
        if path: tr["path"] = path
        ob["transport"] = tr
    return ob


def parse_hysteria2(uri, index):
    u = urllib.parse.urlsplit(uri.strip())

    if u.scheme.lower() not in ("hysteria2", "hy2"):
        raise ValueError("不是 Hysteria2")

    password = urllib.parse.unquote(u.username or "")
    host = u.hostname
    port = u.port

    if not password or not host or not port:
        raise ValueError("地址不完整")

    q = urllib.parse.parse_qs(u.query)

    def one(name, default=""):
        return urllib.parse.unquote(q.get(name, [default])[0])

    name = urllib.parse.unquote(u.fragment or f"节点-{index:02d}")
    tag = f"{index:02d}-{name}"

    ob = {
        "type": "hysteria2",
        "tag": tag,
        "server": host,
        "server_port": port,
        "password": password,
    }

    tls = {"enabled": True}

    sni = one("sni") or one("serverName")
    if sni:
        tls["server_name"] = sni

    insecure = one("insecure").lower()
    if insecure in ("1", "true", "yes"):
        tls["insecure"] = True

    ob["tls"] = tls

    obfs = one("obfs")
    obfs_password = one("obfs-password") or one("obfs_password")

    if obfs:
        ob["obfs"] = {
            "type": obfs,
            "password": obfs_password,
        }

    return ob

def download_subscription(url):
    print("正在下载订阅...")
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=180) as r:
        data = r.read()
    print(f"✓ 下载完成：{len(data)} bytes")
    return data

def decode_subscription(data):
    text = data.decode("utf-8", errors="ignore").strip()

    protocols = ("vless://", "hysteria2://", "hy2://")

    if any(protocol in text for protocol in protocols):
        return text

    compact = "".join(text.split())
    compact += "=" * ((4 - len(compact) % 4) % 4)

    try:
        decoded = base64.b64decode(compact).decode("utf-8", errors="ignore")
        if any(protocol in decoded for protocol in protocols):
            return decoded
    except Exception:
        pass

    raise RuntimeError("订阅中没有找到可识别的 VLESS/Hysteria2 节点")

def build_nodes(text):
    links = [
        x.strip()
        for x in text.splitlines()
        if x.strip().lower().startswith(
            ("vless://", "hysteria2://", "hy2://")
        )
    ]

    if not links:
        raise RuntimeError("没有找到 VLESS/Hysteria2 节点")

    # 一些订阅会把流量、重置时间、到期时间等信息
    # 伪装成 VLESS 链接。根据节点名称过滤这些非代理条目。
    info_keywords = (
        "剩余流量",
        "流量剩余",
        "距离下次重置",
        "下次重置",
        "套餐到期",
        "到期时间",
        "过期时间",
        "有效期",
    )

    nodes = []
    skipped_info = 0

    for i, link in enumerate(links, 1):
        try:
            if link.lower().startswith("vless://"):
                node = parse_vless(link, i)
            elif link.lower().startswith(("hysteria2://", "hy2://")):
                node = parse_hysteria2(link, i)
            else:
                continue

            tag = node.get("tag", "")

            if any(keyword in tag for keyword in info_keywords):
                skipped_info += 1
                print(f"跳过订阅信息：{tag}")
                continue

            nodes.append(node)

        except Exception as e:
            print(f"跳过节点 {i}: {e}")

    if not nodes:
        raise RuntimeError("所有节点解析失败")

    vless_count = sum(node.get("type") == "vless" for node in nodes)
    hy2_count = sum(node.get("type") == "hysteria2" for node in nodes)
    print(
        f"✓ 成功解析 {len(nodes)} 个节点："
        f"VLESS {vless_count}，Hysteria2 {hy2_count}"
    )

    if skipped_info:
        print(f"✓ 已过滤 {skipped_info} 个订阅信息条目")

    return nodes

def make_config(nodes):
    tags = [x["tag"] for x in nodes]
    return {
        "log": {"level": "info", "timestamp": True},
        "inbounds": [{"type": "mixed", "tag": "mixed-in", "listen": HOST, "listen_port": PORT}],
        "outbounds": [
            {"type": "selector", "tag": "proxy", "outbounds": tags, "default": tags[0]},
            *nodes,
            {"type": "direct", "tag": "direct"}
        ],
        "route": {"final": "proxy"}
    }

def save_config(cfg, path):
    Path(path).write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")

def probe_node(node, checks=1, timeout=5, test_port=TEST_PORT):
    """
    启动临时代理并进行 GitHub HEAD 检查。

    返回：
      (成功次数, 总次数, 成功请求平均耗时)

    如果全部失败，平均耗时为 None。
    """
    cfg = {
        "log": {"level": "error"},
        "inbounds": [{
            "type": "mixed",
            "tag": "test-in",
            "listen": HOST,
            "listen_port": test_port
        }],
        "outbounds": [node, {"type": "direct", "tag": "direct"}],
        "route": {"final": node["tag"]}
    }

    fd, name = tempfile.mkstemp(prefix="sb-test-", suffix=".json")
    os.close(fd)
    path = Path(name)
    save_config(cfg, path)

    proc = None
    times = []

    try:
        proc = subprocess.Popen(
            [str(ensure_binary()), "run", "-c", str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        time.sleep(0.5)

        for i in range(checks):
            r = run([
                "curl",
                "--proxy", f"http://{HOST}:{test_port}",
                "--connect-timeout", str(timeout),
                "--max-time", str(timeout),
                "-I", "-L",
                "-o", "/dev/null",
                "-s",
                "-w", "%{http_code} %{time_total}",
                "https://github.com/favicon.ico"
            ], capture=True)

            if r.returncode == 0:
                try:
                    parts = r.stdout.strip().split()

                    if (
                        len(parts) == 2
                        and parts[0] in ("200", "301", "302")
                    ):
                        times.append(float(parts[1]))
                except Exception:
                    pass

            if checks > 1 and i < checks - 1:
                time.sleep(0.2)

        avg = sum(times) / len(times) if times else None
        return len(times), checks, avg

    except Exception:
        return 0, checks, None

    finally:
        if proc:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

        try:
            path.unlink()
        except Exception:
            pass


def probe_nodes_parallel(nodes, checks=5, timeout=6):
    """并发测试多个节点；每个 worker 独占一个测试端口。"""
    nodes = list(nodes)
    if not nodes:
        return []

    worker_count = min(HEAD_WORKERS, len(nodes))

    # 每个 worker 固定使用自己的端口。
    queues = [[] for _ in range(worker_count)]
    for index, node in enumerate(nodes):
        queues[index % worker_count].append((index, node))

    def worker(worker_id, jobs):
        test_port = TEST_PORT + worker_id
        results = []

        for index, node in jobs:
            success, total, latency = probe_node(
                node,
                checks=checks,
                timeout=timeout,
                test_port=test_port,
            )
            results.append(
                (index, node, success, total, latency)
            )

        return results

    all_results = []

    with concurrent.futures.ThreadPoolExecutor(
        max_workers=worker_count
    ) as executor:
        futures = [
            executor.submit(worker, worker_id, jobs)
            for worker_id, jobs in enumerate(queues)
            if jobs
        ]

        for future in concurrent.futures.as_completed(futures):
            all_results.extend(future.result())

    # 恢复原节点顺序，方便菜单和输出保持一致。
    all_results.sort(key=lambda x: x[0])
    return all_results


def download_test_node(node):
    """候选节点 500 KB 下载测速。"""
    cfg = {
        "log": {"level": "error"},
        "inbounds": [{
            "type": "mixed",
            "tag": "test-in",
            "listen": HOST,
            "listen_port": TEST_PORT
        }],
        "outbounds": [node, {"type": "direct", "tag": "direct"}],
        "route": {"final": node["tag"]}
    }

    fd, name = tempfile.mkstemp(prefix="sb-test-", suffix=".json")
    os.close(fd)
    path = Path(name)
    save_config(cfg, path)

    proc = None
    speed = 0.0

    try:
        proc = subprocess.Popen(
            [str(ensure_binary()), "run", "-c", str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        time.sleep(0.5)

        r = run([
            "curl",
            "--proxy", f"http://{HOST}:{TEST_PORT}",
            "--connect-timeout", "5",
            "--max-time", "10",
            "-L",
            "-o", "/dev/null",
            "-s",
            "-w", "%{speed_download}",
            f"https://speed.cloudflare.com/__down?bytes={TEST_BYTES}"
        ], capture=True)

        if r.returncode == 0:
            try:
                speed = float(r.stdout.strip())
            except Exception:
                pass

    except Exception:
        pass

    finally:
        if proc:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

        try:
            path.unlink()
        except Exception:
            pass

    return speed


def node_multiplier(tag):
    """解析节点倍率；未明确标注倍率时按 1 倍处理。"""
    tag = tag.casefold()

    patterns = (
        r"(?<![\d.])([0-9]+(?:\.[0-9]+)?)\s*(?:倍率|倍|[x×✕])(?![a-z0-9.])",
        r"(?:倍率|[x×✕])\s*[:：=]?\s*([0-9]+(?:\.[0-9]+)?)(?![\d.])",
    )

    for pattern in patterns:
        match = re.search(pattern, tag)
        if match:
            return float(match.group(1))

    # 没有标倍率 = 1 倍
    return 1.0


def node_priority(node):
    """倍率越低优先级越高。"""
    multiplier = node_multiplier(node.get("tag", ""))

    if multiplier == 0.01:
        return 0
    if multiplier == 0.1:
        return 1
    if multiplier == 1.0:
        return 2

    # 其他特殊倍率
    return 3


NODE_GROUP_TITLES = (
    "0.01 倍率",
    "0.1 倍率",
    "1 倍率",
    "其他倍率",
)

def speedtest_nodes(nodes):
    speedtest_cache = load_speedtest_cache()

    # 纯倍率优先：
    # 0.01 倍 -> 0.1 倍 -> 1 倍 -> 其他特殊倍率
    # 未标明倍率的节点由 node_multiplier() 按 1 倍处理。
    titles = (
        "0.01 倍率",
        "0.1 倍率",
        "1 倍率",
        "其他倍率",
    )

    groups = [[] for _ in titles]

    for node in nodes:
        priority = node_priority(node)
        groups[priority].append(node)

    print("\n节点分组：" + "，".join(
        f"{title} {len(group)} 个"
        for title, group in zip(titles, groups)
    ))

    def verify_group(group, title):
        if not group:
            return []

        print(
            f"\n{title}：稳定性测试"
            f"（每节点 5 次 GitHub HEAD）...\n"
        )

        results = []
        total = len(group)

        print(
            f"并发 HEAD 测试：最多 {HEAD_WORKERS} 个节点同时测试..."
        )

        probe_results = probe_nodes_parallel(
            group,
            checks=5,
            timeout=6,
        )

        for index, node, success, checks, latency in probe_results:
            i = index + 1
            rate = success / checks

            # 保存最近一次稳定性测试结果。
            # 每次重新测试稳定性时，旧的下载速度失效，
            # 避免菜单显示不同批次的历史下载速度。
            speedtest_cache[node["tag"]] = {
                "success_rate": rate,
                "latency": latency,
                "speed": None,
                "tested_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            }
            save_speedtest_cache(speedtest_cache)

            if success == 0 or latency is None:
                print(
                    f"[{i:02d}/{total:02d}] "
                    f"{success}/{checks} "
                    f"({rate*100:3.0f}%)  "
                    f"FAIL       {node['tag']}"
                )
                continue

            print(
                f"[{i:02d}/{total:02d}] "
                f"{success}/{checks} "
                f"({rate*100:3.0f}%)  "
                f"{latency*1000:6.0f} ms   "
                f"{node['tag']}"
            )

            # 至少 4/5（80%）才允许进入下载测速候选。
            # 不达标的节点直接淘汰，不消耗下载测速流量。
            if rate >= 0.8:
                results.append((rate, latency, node))
            else:
                print("         ↳ <80%，跳过下载测速")

        results.sort(key=lambda x: (-x[0], x[1]))
        return results

    speed_results = []
    for title, group in zip(titles, groups):
        if not group:
            continue
        qualified = verify_group(group, title)
        if not qualified:
            print(f"\n! {title}没有节点达到 80% 成功率，继续测试下一优先级")
            continue
        # 达到 80% 成功率即具备下载测速资格。
        # 为控制测速流量，只根据轻量检测结果预筛最多 3 个候选：
        # 成功率高优先，同成功率下延迟低优先。
        # 最终节点由实际下载速度决定。
        stable = sorted(
            qualified,
            key=lambda x: (-x[0], x[1])
        )[:3]

        print(
            f"\n下载测速 {len(stable)} 个候选"
            f"（每节点约 {TEST_BYTES/1_000_000:.1f} MB）...\n"
        )

        speed_results = []

        for i, (rate, latency, node) in enumerate(stable, 1):
            speed = download_test_node(node)

            # 补充最近一次下载测速结果。
            record = speedtest_cache.setdefault(node["tag"], {})
            record["success_rate"] = rate
            record["latency"] = latency
            record["speed"] = speed if speed > 0 else None
            record["tested_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
            save_speedtest_cache(speedtest_cache)

            if speed > 0:
                print(
                    f"[{i:02d}/{len(stable):02d}] "
                    f"{rate*100:3.0f}%  "
                    f"{latency*1000:5.0f} ms  "
                    f"{speed/1024/1024:6.2f} MB/s "
                    f"({speed*8/1_000_000:6.2f} Mbps)  "
                    f"{node['tag']}"
                )
                speed_results.append(
                    (rate, latency, speed, node)
                )
            else:
                print(
                    f"[{i:02d}/{len(stable):02d}] "
                    f"{rate*100:3.0f}%  "
                    f"{latency*1000:5.0f} ms  "
                    f"FAIL  {node['tag']}"
                )

        if speed_results:
            print(f"\n✓ 优先使用{title}")
            break
        print(f"\n! {title}下载测速全部失败，继续测试下一优先级")

    if not speed_results:
        raise RuntimeError("所有优先级均无稳定且下载成功的节点，保留原配置")

    # 合格候选优先下载速度，其次成功率和延迟。
    speed_results.sort(
        key=lambda x: (-x[2], -x[0], x[1])
    )

    ranked_tags = {
        node["tag"]
        for _, _, _, node in speed_results
    }

    remaining = [
        node for node in nodes
        if node["tag"] not in ranked_tags
    ]
    remaining.sort(key=lambda node: node_priority(node))

    ordered = [
        node
        for _, _, _, node in speed_results
    ] + remaining

    print("\n========== 最终排名 ==========")

    for i, (rate, latency, speed, node) in enumerate(
        speed_results, 1
    ):
        print(
            f"{i:2d}. "
            f"{rate*100:3.0f}%  "
            f"{latency*1000:5.0f} ms  "
            f"{speed/1024/1024:6.2f} MB/s "
            f"({speed*8/1_000_000:6.2f} Mbps)  "
            f"{node['tag']}"
        )

    best_rate, best_latency, best_speed, best_node = (
        speed_results[0]
    )

    print(
        f"\n✓ 推荐节点：{best_node['tag']}\n"
        f"  成功率：{best_rate*100:.0f}%\n"
        f"  平均延迟：{best_latency*1000:.0f} ms\n"
        f"  下载速度：{best_speed/1024/1024:.2f} MB/s"
    )

    return ordered

def setup():
    require_root()
    ensure_binary()
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    url = getpass.getpass("请输入订阅链接（输入不会显示）: ").strip()
    if not url:
        print("✗ 未输入订阅链接")
        return
    try:
        nodes = build_nodes(decode_subscription(download_subscription(url)))
        nodes = speedtest_nodes(nodes)
        cfg = make_config(nodes)
        tmp = CONFIG_DIR / "config.json.new"
        save_config(cfg, tmp)
        print("\n检查新配置...")
        if not check_config(tmp):
            print("✗ 新配置检查失败；原配置未修改")
            try: tmp.unlink()
            except FileNotFoundError: pass
            return
        if CONFIG.exists():
            shutil.copy2(CONFIG, BACKUP)
            print(f"✓ 旧配置备份：{BACKUP}")
        os.replace(tmp, CONFIG)
        print(f"✓ 配置已保存：{CONFIG}")
        print(f"✓ 默认推荐节点：{nodes[0]['tag']}")
        git_on()
        stop(quiet=True)
        start()
    except Exception as e:
        print(f"✗ 配置失败：{e}")
        print("原有配置不会因本次失败而被覆盖。")

