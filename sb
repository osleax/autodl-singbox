def run(cmd, capture=False, check=False, **kwargs):
    if capture:
        return subprocess.run(cmd, text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, check=check, **kwargs)
    return subprocess.run(cmd, check=check, **kwargs)

def is_root():
    return os.geteuid() == 0

def require_root():
    if not is_root():
        print("✗ 此命令需要 root 权限。")
        sys.exit(1)

def load_speedtest_cache():
    """读取最近一次节点测试数据。"""
    if not SPEEDTEST_CACHE.is_file():
        return {}

    try:
        data = json.loads(SPEEDTEST_CACHE.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return data
    except (OSError, json.JSONDecodeError):
        pass

    return {}


def save_speedtest_cache(data):
    """保存节点测试数据。"""
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)

        tmp = SPEEDTEST_CACHE.with_suffix(".json.tmp")
        tmp.write_text(
            json.dumps(data, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        tmp.replace(SPEEDTEST_CACHE)
    except OSError as e:
        print(f"⚠ 保存测速记录失败：{e}")


def current_script():
    return Path(__file__).resolve()

def binary_path():
    # Installed mode.
    if SYSTEM_BIN.exists():
        return SYSTEM_BIN
    # Portable/pre-install mode: sing-box beside sb.
    p = current_script().parent / "sing-box"
    if p.exists():
        return p
    return SYSTEM_BIN

def ensure_binary():
    p = binary_path()
    if not p.is_file():
        print(f"✗ 找不到 sing-box：{p}")
        print("首次安装时，请把 sb 和 sing-box 放在同一个目录后运行：")
        print("  chmod +x sb sing-box")
        print("  ./sb install")
        sys.exit(1)
    if not os.access(p, os.X_OK):
        try:
            p.chmod(p.stat().st_mode | 0o111)
        except Exception:
            pass
    return p

def autodl_turbo_env():
    """Load AutoDL /etc/network_turbo into a subprocess environment."""
    env = os.environ.copy()
    turbo = Path("/etc/network_turbo")
    if not turbo.exists():
        return env, False
    try:
        r = subprocess.run(
            ["bash", "-lc", "source /etc/network_turbo >/dev/null 2>&1; env -0"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        for item in r.stdout.split(b"\0"):
            if b"=" in item:
                k, v = item.split(b"=", 1)
                env[k.decode(errors="ignore")] = v.decode(errors="ignore")
        return env, True
    except Exception:
        return env, False

def autodl_arch():
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return "amd64"
    if m in ("aarch64", "arm64"):
        return "arm64"
    raise RuntimeError(f"暂不支持的 CPU 架构：{m}")

def latest_stable_version(env):
    # GitHub API: releases/latest excludes prereleases.
    api = "https://api.github.com/repos/SagerNet/sing-box/releases/latest"
    req = urllib.request.Request(api, headers={
        "User-Agent": "autodl-singbox-sb",
        "Accept": "application/vnd.github+json"
    })
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({
            scheme: value
            for scheme, value in {
                "http": env.get("http_proxy") or env.get("HTTP_PROXY"),
                "https": env.get("https_proxy") or env.get("HTTPS_PROXY"),
            }.items()
            if value
        })
    )
    with opener.open(req, timeout=60) as r:
        obj = json.loads(r.read().decode("utf-8"))
    tag = obj.get("tag_name", "")
    if not re.fullmatch(r"v?\d+\.\d+\.\d+", tag):
        raise RuntimeError(f"无法识别稳定版本：{tag}")
    return tag.lstrip("v")

def download_sing_box(dest):
    arch = autodl_arch()
    env, turbo = autodl_turbo_env()
    if turbo:
        print("✓ 检测到 AutoDL 学术资源加速 /etc/network_turbo")
        print("  将仅用于本次官方 sing-box 下载。")
    else:
        print("⚠ 未检测到 /etc/network_turbo，将直接访问 GitHub。")

    print("查询 sing-box 官方最新稳定版...")
    version = latest_stable_version(env)
    print(f"✓ 最新稳定版：{version}")

    filename = f"sing-box-{version}-linux-{arch}.tar.gz"
    url = f"https://github.com/SagerNet/sing-box/releases/download/v{version}/{filename}"

    with tempfile.TemporaryDirectory(prefix="sb-install-") as td:
        archive = Path(td) / filename
        print(f"下载官方 sing-box ({arch})...")
        r = subprocess.run(
            ["curl", "-fL", "--retry", "3", "--connect-timeout", "15",
             "-o", str(archive), url],
            env=env
        )
        if r.returncode != 0:
            raise RuntimeError("sing-box 下载失败")

        print("解压...")
        with tarfile.open(archive, "r:gz") as tf:
            tf.extractall(td)

        candidates = [
            p for p in Path(td).rglob("sing-box")
            if p.is_file()
        ]
        if not candidates:
            raise RuntimeError("压缩包中未找到 sing-box")

        shutil.copy2(candidates[0], dest)
        dest.chmod(0o755)

    # Validate downloaded binary.
    r = subprocess.run([str(dest), "version"])
    if r.returncode != 0:
        try:
            dest.unlink()
        except Exception:
            pass
        raise RuntimeError("下载的 sing-box 无法运行")

def install():
    require_root()
    src_sb = current_script()

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SYSTEM_SB.parent.mkdir(parents=True, exist_ok=True)

    # Install/update sb itself.
    if src_sb != SYSTEM_SB:
        shutil.copy2(src_sb, SYSTEM_SB)
    SYSTEM_SB.chmod(0o755)

    # Prefer a binary beside sb if the user already supplied one.
    local_bin = src_sb.parent / "sing-box"
    try:
        if local_bin.is_file() and local_bin.resolve() != SYSTEM_BIN.resolve():
            print("发现当前目录已有 sing-box，直接安装。")
            shutil.copy2(local_bin, SYSTEM_BIN)
            SYSTEM_BIN.chmod(0o755)
        elif SYSTEM_BIN.is_file():
            print("✓ 已存在 sing-box，保留当前版本。")
        else:
            download_sing_box(SYSTEM_BIN)
    except Exception as e:
        print(f"✗ sing-box 安装失败：{e}")
        print("sb 已安装，但 sing-box 尚未就绪。")
        print("可检查 AutoDL 网络后重新执行：sb install")
        return

    print()
    print("✓ AutoDL 专用版安装完成")
    print(f"  sb:       {SYSTEM_SB}")
    print(f"  sing-box: {SYSTEM_BIN}")
    print(f"  配置:     {CONFIG}")
    print(f"  日志:     {LOGFILE}")
    print()
    print("下一步：")
    print("  sb setup")

def uninstall():
    require_root()
    stop(quiet=True)
    print("将卸载程序：")
    print(f"  {SYSTEM_SB}")
    print(f"  {SYSTEM_BIN}")
    ans = input("继续？[y/N]: ").strip().lower()
    if ans not in ("y", "yes"):
        print("已取消")
        return

    for p in (SYSTEM_SB, SYSTEM_BIN):
        try:
            p.unlink()
        except FileNotFoundError:
            pass

    ans = input(f"是否同时删除 {CONFIG_DIR} 中的配置/备份？[y/N]: ").strip().lower()
    if ans in ("y", "yes"):
        shutil.rmtree(CONFIG_DIR, ignore_errors=True)

    try:
        PIDFILE.unlink()
    except FileNotFoundError:
        pass

    print("✓ 卸载完成")
    print("日志默认保留：", LOGFILE)

def find_pid():
    try:
        if PIDFILE.exists():
            pid = int(PIDFILE.read_text().strip())
            os.kill(pid, 0)
            return pid
    except Exception:
        pass

    try:
        r = run(["pgrep", "-f", r"[s]ing-box.*run.*config\.json"], capture=True)
        for s in r.stdout.split():
            try:
                pid = int(s)
                os.kill(pid, 0)
                return pid
            except Exception:
                continue
    except Exception:
        pass
    return None

def proxy_test(timeout=15, retries=3):
    for attempt in range(retries):
        try:
            r = run([
                "curl", "--proxy", f"http://{HOST}:{PORT}",
                "--connect-timeout", "10", "--max-time", str(timeout),
                "-I", "-L", "-o", "/dev/null", "-s", "-w", "%{http_code}",
                "https://github.com/favicon.ico"
            ], capture=True)

            if r.returncode == 0 and r.stdout.strip() in ("200", "301", "302"):
                return True

        except FileNotFoundError:
            return False

        if attempt < retries - 1:
            time.sleep(1)

    return False

def check_config(path=CONFIG):
    b = ensure_binary()
    return run([str(b), "check", "-c", str(path)]).returncode == 0

def start():
    require_root()
    ensure_binary()
    if not CONFIG.is_file():
        print(f"✗ 找不到 {CONFIG}")
        print("请先运行：sb setup")
        return

    pid = find_pid()
    if pid:
        print(f"✓ sing-box 已运行，PID: {pid}")
        print("代理正常" if proxy_test() else "⚠ 进程存在，但代理测试失败；可执行 sb restart / sb log")
        return

    print("检查配置...")
    if not check_config():
        print("✗ 配置检查失败")
        return

    print("启动 sing-box...")
    LOGFILE.parent.mkdir(parents=True, exist_ok=True)
    log = open(LOGFILE, "ab", buffering=0)
    proc = subprocess.Popen(
        [str(binary_path()), "run", "-c", str(CONFIG)],
        stdout=log, stderr=log, start_new_session=True
    )
    PIDFILE.write_text(str(proc.pid))
    time.sleep(2)

    if proc.poll() is None:
        print(f"✓ sing-box 启动成功，PID: {proc.pid}")
        print(f"代理: http://{HOST}:{PORT}")
        print("✓ GitHub 代理正常" if proxy_test() else "⚠ 已启动，但 GitHub 测试失败；运行 sb log 查看")
    else:
        try: PIDFILE.unlink()
        except FileNotFoundError: pass
        print("✗ sing-box 启动失败")
        show_log()

def stop(quiet=False):
    require_root()
    pid = find_pid()
    if not pid:
        try: PIDFILE.unlink()
        except FileNotFoundError: pass
        if not quiet:
            print("sing-box 未运行")
        return

    if not quiet:
        print(f"停止 sing-box (PID {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(15):
            try:
                os.kill(pid, 0)
                time.sleep(0.2)
            except ProcessLookupError:
                break
        try:
            os.kill(pid, 0)
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    except ProcessLookupError:
        pass
    finally:
        try: PIDFILE.unlink()
        except FileNotFoundError: pass
    if not quiet:
        print("✓ sing-box 已停止")

def restart():
    stop()
    time.sleep(0.5)
    start()

def status():
